{
	"$schema": "https://biomejs.dev/schemas/2.4.9/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/node_modules",
			"!**/playwright-report",
			"!**/test-results",
			"!**/bun.lock"
		]
	},
	"formatter": { "indentStyle": "tab" },
	"linter": { "enabled": true, "rules": { "recommended": true } },
	"assist": { "actions": { "source": { "organizeImports": "on" } } }
}
